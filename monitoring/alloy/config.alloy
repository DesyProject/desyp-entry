// logs/desyp-entry.log(ECS JSON)를 읽어 Loki로 보낸다
local.file_match "app" {
  path_targets = [{"__path__" = "/var/log/desyp/*.log", "job" = "desyp-entry"}]
}

loki.source.file "app" {
  targets    = local.file_match.app.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  stage.json {
    expressions = { level = "\"log.level\"" }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
